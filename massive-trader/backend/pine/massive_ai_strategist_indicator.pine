//@version=5
indicator("Massive AI Strategist – Momentum & News Signal Visualizer", overlay=false, shorttitle="AI Strategist")

// ============================================================================
// USER INPUTS
// ============================================================================

// AI Score Input (0-100)
ai_score = input.float(50, title="AI Score (0-100)", minval=0, maxval=100, step=1, group="AI Signal")

// Threshold Inputs
strong_buy_threshold = input.float(85, title="Strong Buy Threshold", minval=0, maxval=100, step=1, group="Thresholds")
buy_threshold = input.float(70, title="Buy Threshold", minval=0, maxval=100, step=1, group="Thresholds")
sell_threshold = input.float(30, title="Sell Threshold", minval=0, maxval=100, step=1, group="Thresholds")
strong_sell_threshold = input.float(15, title="Strong Sell Threshold", minval=0, maxval=100, step=1, group="Thresholds")

// Visual Settings
show_markers = input.bool(true, title="Show Signal Markers", group="Visual Settings")
show_bg_zones = input.bool(true, title="Show Background Zones", group="Visual Settings")
show_threshold_lines = input.bool(true, title="Show Threshold Lines", group="Visual Settings")
show_labels = input.bool(true, title="Show Signal Labels", group="Visual Settings")

// Colors
color_strong_buy = input.color(color.new(color.green, 0), title="Strong Buy Color", group="Colors")
color_buy = input.color(color.new(color.green, 40), title="Buy Color", group="Colors")
color_neutral = input.color(color.new(color.gray, 60), title="Neutral Color", group="Colors")
color_sell = input.color(color.new(color.red, 40), title="Sell Color", group="Colors")
color_strong_sell = input.color(color.new(color.red, 0), title="Strong Sell Color", group="Colors")

// ============================================================================
// AI CLASSIFICATION LOGIC
// ============================================================================

// Classify the AI signal based on thresholds
isStrongBuy = ai_score >= strong_buy_threshold
isBuy = ai_score >= buy_threshold and not isStrongBuy
isSell = ai_score <= sell_threshold and ai_score > strong_sell_threshold
isStrongSell = ai_score <= strong_sell_threshold
isNeutral = not isStrongBuy and not isBuy and not isSell and not isStrongSell

// Get signal type for current bar
signal_type = isStrongBuy ? "STRONG BUY" : isBuy ? "BUY" : isStrongSell ? "STRONG SELL" : isSell ? "SELL" : "NEUTRAL"

// ============================================================================
// AI SCORE PLOT
// ============================================================================

// Plot the AI score as a line
score_color = isStrongBuy ? color_strong_buy : isBuy ? color_buy : isStrongSell ? color_strong_sell : isSell ? color_sell : color_neutral
plot(ai_score, title="AI Score", color=score_color, linewidth=2, style=plot.style_line)

// ============================================================================
// THRESHOLD LINES
// ============================================================================

// Plot horizontal threshold lines
if show_threshold_lines
    hline(strong_buy_threshold, title="Strong Buy Line", color=color_strong_buy, linestyle=hline.style_dashed, linewidth=1)
    hline(buy_threshold, title="Buy Line", color=color_buy, linestyle=hline.style_dotted, linewidth=1)
    hline(50, title="Neutral Line", color=color_neutral, linestyle=hline.style_solid, linewidth=1)
    hline(sell_threshold, title="Sell Line", color=color_sell, linestyle=hline.style_dotted, linewidth=1)
    hline(strong_sell_threshold, title="Strong Sell Line", color=color_strong_sell, linestyle=hline.style_dashed, linewidth=1)

// ============================================================================
// BACKGROUND ZONES
// ============================================================================

// Color the background based on sentiment regime
bg_color = isStrongBuy ? color.new(color_strong_buy, 85) :
           isBuy ? color.new(color_buy, 90) :
           isStrongSell ? color.new(color_strong_sell, 85) :
           isSell ? color.new(color_sell, 90) :
           color.new(color_neutral, 95)

if show_bg_zones
    bgcolor(bg_color, title="Sentiment Zone")

// ============================================================================
// SIGNAL MARKERS
// ============================================================================

// Plot signal markers
if show_markers
    plotshape(isStrongBuy, title="Strong Buy Marker", style=shape.triangleup, location=location.top,
              color=color_strong_buy, size=size.normal, text="STRONG\nBUY")
    plotshape(isBuy, title="Buy Marker", style=shape.triangleup, location=location.top,
              color=color_buy, size=size.small, text="BUY")
    plotshape(isStrongSell, title="Strong Sell Marker", style=shape.triangledown, location=location.bottom,
              color=color_strong_sell, size=size.normal, text="STRONG\nSELL")
    plotshape(isSell, title="Sell Marker", style=shape.triangledown, location=location.bottom,
              color=color_sell, size=size.small, text="SELL")

// ============================================================================
// SIGNAL LABELS
// ============================================================================

// Create a label showing current signal
if show_labels and barstate.islast
    label_text = "AI Score: " + str.tostring(ai_score, "##.#") + "\nSignal: " + signal_type
    label_color = isStrongBuy ? color_strong_buy : isBuy ? color_buy :
                  isStrongSell ? color_strong_sell : isSell ? color_sell : color_neutral

    label.new(bar_index, ai_score, label_text,
              xloc=xloc.bar_index, yloc=yloc.price,
              style=label.style_label_left,
              color=label_color,
              textcolor=color.white,
              size=size.normal)

// ============================================================================
// ALERT CONDITIONS
// ============================================================================

// Create alert conditions for each signal type
alertcondition(isStrongBuy, title="AI STRONG BUY", message="AI Signal: STRONG BUY | Score: " + str.tostring(ai_score))
alertcondition(isBuy, title="AI BUY", message="AI Signal: BUY | Score: " + str.tostring(ai_score))
alertcondition(isSell, title="AI SELL", message="AI Signal: SELL | Score: " + str.tostring(ai_score))
alertcondition(isStrongSell, title="AI STRONG SELL", message="AI Signal: STRONG SELL | Score: " + str.tostring(ai_score))

// Alert for any signal change
signal_changed = ta.change(ai_score) != 0
alertcondition(signal_changed, title="AI Signal Changed", message="AI Signal Updated | New Score: " + str.tostring(ai_score) + " | Signal: " + signal_type)

// ============================================================================
// INFORMATION TABLE
// ============================================================================

// Create an information table in the corner
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80))

if barstate.islast
    // Update table headers
    table.cell(infoTable, 0, 0, "Metric", bgcolor=color.new(color.gray, 50), text_color=color.white)
    table.cell(infoTable, 1, 0, "Value", bgcolor=color.new(color.gray, 50), text_color=color.white)

    // Update table values
    table.cell(infoTable, 0, 1, "AI Score", text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(ai_score, "##.#"), text_color=score_color)

    table.cell(infoTable, 0, 2, "Signal", text_color=color.white)
    table.cell(infoTable, 1, 2, signal_type, text_color=score_color)

    table.cell(infoTable, 0, 3, "Strong Buy >", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(strong_buy_threshold), text_color=color_strong_buy)

    table.cell(infoTable, 0, 4, "Buy >", text_color=color.white)
    table.cell(infoTable, 1, 4, str.tostring(buy_threshold), text_color=color_buy)

    table.cell(infoTable, 0, 5, "Sell <", text_color=color.white)
    table.cell(infoTable, 1, 5, str.tostring(sell_threshold), text_color=color_sell)

// ============================================================================
// NOTES FOR FUTURE INTEGRATION
// ============================================================================

// To integrate with your backend API later:
// 1. Replace the manual ai_score input with a value from:
//    - A CSV file import
//    - A webhook data feed
//    - Manual updates based on API calls
//
// 2. Use TradingView alerts to trigger webhooks that call your API:
//    Alert → Webhook → Your FastAPI → Execute trade on Alpaca
//
// 3. Consider using the 'request.security' function to fetch scores
//    for multiple symbols if needed
//
// 4. The ai_score can be replaced with a calculated value:
//    ai_score = your_custom_calculation()
//
// 5. For backtesting, you could create a strategy version that:
//    - Enters long on BUY/STRONG BUY
//    - Exits or goes short on SELL/STRONG SELL
//    - Uses the AI score as position sizing factor

// ============================================================================
// END OF INDICATOR
// ============================================================================